# luna engine - keep the repo clean and personal-data-free.
# Anything you create/run locally (hub config, brain, per-project state) stays local.
# NOTE: git treats "pattern  # comment" as a literal filename, so every comment is on its
# OWN line below. Do NOT put trailing comments on pattern lines.

# your local hub path - machine-specific
luna.config.json

# any brain/memory created in a workspace
memory/

# per-project state files (created by new_project)
*_TODO.txt
_*_run_STATUS.md
state/

# OS / editor cruft
*.tmp
*.swp
Thumbs.db
desktop.ini
.DS_Store
