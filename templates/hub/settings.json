{
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [
        { "type": "command", "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/prompt_router.ps1" }
      ] }
    ],
    "PreToolUse": [
      { "matcher": ".*", "hooks": [
        { "type": "command", "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/hold_guard.ps1" }
      ] },
      { "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell|Agent|Workflow", "hooks": [
        { "type": "command", "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/main_agent_guard.ps1" }
      ] },
      { "matcher": "Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit", "hooks": [
        { "type": "command", "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/reviewer_guard.ps1" }
      ] }
    ],
    "Stop": [
      { "matcher": "*", "hooks": [
        { "type": "command", "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/stop_guard.ps1" }
      ] }
    ]
  }
}
